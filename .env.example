# Copie este arquivo para ".env" e ajuste os valores antes de rodar o projeto.
# NUNCA suba o arquivo ".env" de verdade para um repositório Git.

DJANGO_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=sigha
DB_USER=sigha
DB_PASSWORD=sigha
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1?socket_connect_timeout=3&socket_timeout=3

# Módulo 17 (Backup) — opcionais, os padrões já funcionam no Docker Compose.
# BACKUP_DIR=/app/backups
# BACKUP_RETENCAO_DIAS=30
# PG_DUMP_BIN=pg_dump
# PSQL_BIN=psql
